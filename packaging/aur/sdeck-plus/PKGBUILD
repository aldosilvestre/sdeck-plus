# Maintainer: Aldo Silvestre <aldosilvestre89@gmail.com>
pkgname=sdeck-plus
pkgver=0.2.0
pkgrel=1
pkgdesc="GTK4 control desk for the Elgato Stream Deck + and Stream Deck + XL on Linux"
arch=('x86_64' 'aarch64')
url="https://aldosilvestre.github.io/sdeck-plus/"
license=('MIT')
depends=('gtk4' 'systemd-libs')
makedepends=('cargo' 'pkgconf' 'glib2')
# hidapi's bundled C code is built with -flto by makepkg; rust-lld cannot link it (undefined hid_* symbols).
options=('!lto')
optdepends=('mpv: sound playback'
            'wireplumber: volume and mute (wpctl)'
            'pipewire: audio output discovery (pw-dump)'
            'wl-clipboard: text pasting (wl-copy)'
            'xdg-utils: opening files and websites (xdg-open)'
            'curl: weather information')
source=("$pkgname-$pkgver.tar.gz::https://github.com/aldosilvestre/sdeck-plus/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('de3592b873965e2f505a60745a76b8a4df0547f51bf343f11a36a1057ae519e6')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  CARGO_TARGET_DIR=target cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  # Only core tests: the GTK binary tests need a display and silently pass without one.
  CARGO_TARGET_DIR=target cargo test --frozen --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/sdeck-plus "$pkgdir/usr/bin/sdeck-plus"
  install -Dm644 packaging/dev.streamdeck.EventMonitor.desktop \
    "$pkgdir/usr/share/applications/dev.streamdeck.EventMonitor.desktop"
  install -Dm644 assets/icons/scalable/apps/sdeck-plus.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/sdeck-plus.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 udev/70-sdeck.rules "$pkgdir/usr/lib/udev/rules.d/70-sdeck.rules"
}
