pkgbase = sdeck-plus
	pkgdesc = GTK4 control desk for Elgato Stream Deck devices on Linux
	pkgver = 1.1.0
	pkgrel = 1
	url = https://aldosilvestre.github.io/sdeck-plus/
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = pkgconf
	makedepends = glib2
	depends = gtk4
	depends = systemd-libs
	optdepends = mpv: sound playback
	optdepends = wireplumber: volume and mute (wpctl)
	optdepends = pipewire: audio output discovery (pw-dump)
	optdepends = wtype: typing text into any window
	optdepends = wl-clipboard: text pasting without wtype (wl-copy)
	optdepends = xdg-utils: opening files and websites (xdg-open)
	optdepends = curl: weather information
	options = !lto
