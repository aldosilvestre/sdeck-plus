#!/usr/bin/env python3
"""MeRGBW hexagon light demo extension for sdeck-plus (plugin protocol v1, standard library only).

The packet format is taken from the documented protocol of https://github.com/jmbwell/mergbw
(MIT) and is UNVERIFIED against a Hexagon Light TG609. Bluetooth goes through BlueZ over D-Bus
using only the system `busctl`; the plugin never scans, pairs, trusts, removes or disconnects.
Diagnostics go to stderr; stdout carries exactly one JSON response line.
"""

import json
import os
import re
import subprocess
import sys
import time

PROTOCOL_VERSION = 1
MAX_TEXT = 512
MAX_REQUEST_BYTES = 64 * 1024
MAX_BUSCTL_BYTES = 1024 * 1024
CALL_TIMEOUT_SECONDS = 5
TOTAL_BUDGET_SECONDS = 4.5
POLL_SECONDS = 0.25
BUSCTL_LINE_LIMIT = 100

WRITE_UUID = "0000fff3-0000-1000-8000-00805f9b34fb"
DEVICE_IFACE = "org.bluez.Device1"
CHAR_IFACE = "org.bluez.GattCharacteristic1"
SCENE_SECOND_VALUE = 0x3200  # meaning/scale uncertain in the reference; its default is sent as is

ADDRESS = re.compile(r"([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}")
OBJECT_PATH = re.compile(r"/org/bluez/hci[0-9]+/dev_[0-9A-F_]+(/service[0-9a-f]+/char[0-9a-f]+)?")
REQUEST_ID = re.compile(r"[A-Za-z0-9._-]{1,64}")

UNVERIFIED = "protocol from jmbwell/mergbw, unverified on a TG609"


class PluginFailure(Exception):
    """A failure whose short text is safe to show to the user."""


def clip(text):
    return text if len(text) <= MAX_TEXT else text[: MAX_TEXT - 3] + "..."


# ---------------------------------------------------------------- packets


def checksum(data):
    total = sum(data)
    while total > 0xFF:
        total = (total >> 8) + (total & 0xFF)
    return ~total & 0xFF


def u16(value):
    return [value >> 8, value & 0xFF]


def packet(command, payload):
    body = [0x55, command, 0xFF, 5 + len(payload)] + list(payload)
    return body + [checksum(body)]


def power_packet(on):
    return packet(0x01, [1 if on else 0])


def color_packet(hue, saturation):
    return packet(0x03, u16(hue) + u16(saturation))


def brightness_packet(value):
    return packet(0x05, u16(value))


def scene_packets(scene):
    return [packet(0x06, u16(scene)), packet(0x0F, u16(SCENE_SECOND_VALUE))]


# ---------------------------------------------------------------- validation


def int_setting(settings, name, low, high, default):
    value = settings.get(name, default)
    if type(value) is not int:
        raise PluginFailure(f"setting `{name}` must be an integer")
    if not low <= value <= high:
        raise PluginFailure(f"setting `{name}` must be between {low} and {high}")
    return value


ACTION_SETTINGS = {
    "power-on": (),
    "power-off": (),
    "set-color": ("hue", "saturation", "brightness"),
    "set-brightness": ("brightness",),
    "set-scene": ("scene",),
}


def build_packets(action, settings):
    """Validates settings and returns (normalised address, packet list); no I/O."""
    allowed = ("address",) + ACTION_SETTINGS[action]
    unknown = sorted(set(settings) - set(allowed))
    if unknown:
        raise PluginFailure(f"unknown setting `{str(unknown[0])[:48]}`")
    address = settings.get("address")
    if not isinstance(address, str) or not (address.isascii() and ADDRESS.fullmatch(address)):
        raise PluginFailure("address must look like AA:BB:CC:DD:EE:FF")
    address = address.upper()
    if action == "power-on":
        packets = [power_packet(True)]
    elif action == "power-off":
        packets = [power_packet(False)]
    elif action == "set-color":
        hue = int_setting(settings, "hue", 0, 359, 0)
        saturation = int_setting(settings, "saturation", 0, 100, 100)
        packets = [power_packet(True), color_packet(hue, saturation * 10)]
        if "brightness" in settings:
            packets.append(brightness_packet(int_setting(settings, "brightness", 0, 100, 100) * 10))
    elif action == "set-brightness":
        packets = [brightness_packet(int_setting(settings, "brightness", 0, 100, 100) * 10)]
    else:
        packets = [power_packet(True)] + scene_packets(int_setting(settings, "scene", 1, 117, 2))
    return address, packets


# ---------------------------------------------------------------- busctl transport


def safe_line(text):
    """First line of foreign output, printable ASCII only and truncated."""
    lines = (text or "").strip().splitlines()
    line = lines[0] if lines else ""
    line = "".join(c if 32 <= ord(c) < 127 else "?" for c in line)
    return line[:BUSCTL_LINE_LIMIT]


class Bus:
    """Runs `busctl` calls inside one monotonic time budget."""

    def __init__(self, environ, run, monotonic, sleep):
        self.environ = dict(environ)
        self.run = run
        self.monotonic = monotonic
        self.sleep = sleep
        self.deadline = monotonic() + TOTAL_BUDGET_SECONDS

    def remaining(self):
        return self.deadline - self.monotonic()

    def call(self, step, args):
        timeout = min(CALL_TIMEOUT_SECONDS, self.remaining())
        if timeout <= 0:
            raise PluginFailure(f"{step}: out of time; the host allows 5 s per request")
        argv = ["busctl", "--system"] + args
        try:
            result = self.run(
                argv,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
                stdin=subprocess.DEVNULL,
                env=self.environ,
            )
        except FileNotFoundError:
            raise PluginFailure(f"{step}: busctl was not found") from None
        except subprocess.TimeoutExpired:
            raise PluginFailure(f"{step}: busctl timed out") from None
        except OSError:
            raise PluginFailure(f"{step}: busctl could not be started") from None
        if result.returncode != 0:
            detail = safe_line(result.stderr)
            raise PluginFailure(f"{step}: busctl failed" + (f" ({detail})" if detail else ""))
        return result.stdout or ""

    def managed_objects(self, step):
        out = self.call(
            step,
            [
                "--json=short",
                "call",
                "org.bluez",
                "/",
                "org.freedesktop.DBus.ObjectManager",
                "GetManagedObjects",
            ],
        )
        if len(out) > MAX_BUSCTL_BYTES:
            raise PluginFailure(f"{step}: BlueZ answer is too large")
        try:
            data = json.loads(out)["data"][0]
        except (ValueError, KeyError, IndexError, TypeError):
            raise PluginFailure(f"{step}: unreadable BlueZ answer") from None
        if not isinstance(data, dict):
            raise PluginFailure(f"{step}: unreadable BlueZ answer")
        return data

    def wait_for_sleep(self):
        self.sleep(max(0.0, min(POLL_SECONDS, self.remaining())))


def prop(interfaces, iface, name):
    props = interfaces.get(iface) if isinstance(interfaces, dict) else None
    entry = props.get(name) if isinstance(props, dict) else None
    return entry.get("data") if isinstance(entry, dict) else None


def find_device(objects, address):
    """Returns (path, interfaces) of the Device1 with this address, preferring a connected one."""
    found = [
        (path, ifaces)
        for path, ifaces in objects.items()
        if isinstance(path, str)
        and str(prop(ifaces, DEVICE_IFACE, "Address")).upper() == address
    ]
    found.sort(key=lambda item: prop(item[1], DEVICE_IFACE, "Connected") is not True)
    if not found:
        raise PluginFailure("device not known to BlueZ; pair it first with bluetoothctl")
    path = found[0][0]
    if not OBJECT_PATH.fullmatch(path) or path.count("/") != 4:
        raise PluginFailure("find device: BlueZ returned an unexpected object path")
    return found[0]


def find_characteristic(objects, device_path):
    for path, ifaces in objects.items():
        if not (isinstance(path, str) and path.startswith(device_path + "/")):
            continue
        uuid = prop(ifaces, CHAR_IFACE, "UUID")
        if isinstance(uuid, str) and uuid.lower() == WRITE_UUID:
            if not OBJECT_PATH.fullmatch(path):
                raise PluginFailure("find characteristic: BlueZ returned an unexpected object path")
            return path
    raise PluginFailure("write characteristic fff3 not found on the device")


def connect_and_resolve(bus, address):
    """Returns (device path, managed objects) once the device is connected with services resolved."""
    objects = bus.managed_objects("find device")
    path, ifaces = find_device(objects, address)
    if prop(ifaces, DEVICE_IFACE, "Connected") is not True:
        try:
            bus.call("connect", ["call", "org.bluez", path, DEVICE_IFACE, "Connect"])
        except PluginFailure as failure:
            raise PluginFailure(
                f"{failure}; could not connect in time; close the MeRGBW app and try again"
            ) from None
    while True:
        if prop(ifaces, DEVICE_IFACE, "ServicesResolved") is True:
            return path, objects
        if bus.remaining() <= POLL_SECONDS:
            raise PluginFailure(
                "could not connect in time; close the MeRGBW app and try again"
            )
        bus.wait_for_sleep()
        objects = bus.managed_objects("wait for services")
        ifaces = objects.get(path)
        if ifaces is None:
            raise PluginFailure("device disappeared from BlueZ while connecting")


def write_packets(bus, characteristic, packets):
    total = len(packets)
    for index, data in enumerate(packets, start=1):
        bus.call(
            f"write packet {index}/{total}",
            [
                "call",
                "org.bluez",
                characteristic,
                CHAR_IFACE,
                "WriteValue",
                "aya{sv}",
                str(len(data)),
                *[str(byte) for byte in data],
                "0",
            ],
        )


def control_light(action, settings, environ, run, monotonic, sleep):
    address, packets = build_packets(action, settings)
    bus = Bus(environ, run, monotonic, sleep)
    path, objects = connect_and_resolve(bus, address)
    characteristic = find_characteristic(objects, path)
    write_packets(bus, characteristic, packets)
    count = len(packets)
    return (
        f"Wrote {count} command packet{'s' if count != 1 else ''} to the light's characteristic; "
        f"the light's state is not confirmed ({UNVERIFIED})"
    )


# ---------------------------------------------------------------- framing


def handle(request, environ, run, monotonic, sleep):
    action = request.get("action")
    settings = request.get("settings", {})
    if not isinstance(settings, dict):
        raise PluginFailure("settings must be an object")
    if not isinstance(action, str) or action not in ACTION_SETTINGS:
        raise PluginFailure("unknown action")
    return control_light(action, settings, environ, run, monotonic, sleep)


def reply(stdout, request_id, ok, text):
    body = {"protocol_version": PROTOCOL_VERSION, "request_id": request_id, "ok": ok}
    if text:
        body["message" if ok else "error"] = clip(text)
    stdout.write(json.dumps(body) + "\n")
    stdout.flush()


def main(
    argv=None,
    stdin=None,
    stdout=None,
    environ=None,
    run=None,
    stderr=None,
    monotonic=None,
    sleep=None,
):
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    stderr = sys.stderr if stderr is None else stderr
    environ = os.environ if environ is None else environ
    run = subprocess.run if run is None else run
    monotonic = time.monotonic if monotonic is None else monotonic
    sleep = time.sleep if sleep is None else sleep
    request_id = "unknown"
    try:
        line = stdin.readline(MAX_REQUEST_BYTES + 1)
        try:
            request = json.loads(line)
        except ValueError:
            raise PluginFailure("request is not valid JSON") from None
        if not isinstance(request, dict):
            raise PluginFailure("request must be a JSON object")
        candidate = request.get("request_id")
        if isinstance(candidate, str) and REQUEST_ID.fullmatch(candidate):
            request_id = candidate
        version = request.get("protocol_version")
        if type(version) is not int or version != PROTOCOL_VERSION:
            raise PluginFailure("unsupported protocol_version")
        if request.get("type") != "invoke":
            raise PluginFailure("unsupported request type")
        reply(stdout, request_id, True, handle(request, environ, run, monotonic, sleep))
    except PluginFailure as failure:
        reply(stdout, request_id, False, str(failure))
    except Exception as error:  # last resort: never a traceback, never the error text
        stderr.write(f"mergbw extension internal error: {type(error).__name__}\n")
        reply(stdout, request_id, False, "internal error in the MeRGBW extension")
    return 0


if __name__ == "__main__":
    sys.exit(main())
